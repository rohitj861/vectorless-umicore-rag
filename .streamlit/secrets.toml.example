# Streamlit Community Cloud secrets.
#
# Do NOT commit a real secrets.toml - it is git-ignored for a reason.
# Instead, paste the contents below (with real values) into the
# "Advanced settings -> Secrets" box when you deploy the app, or later via
#   share.streamlit.io -> your app -> Settings -> Secrets
#
# app.py copies these into os.environ at startup, so the same code works
# locally from .env and on Cloud from here.

PAGEINDEX_API_KEY = "your-pageindex-api-key"
OPENAI_API_KEY = "your-openai-api-key"

PAGEINDEX_SEARCH_MODEL = "gpt-4.1-mini"
PAGEINDEX_ANSWER_MODEL = "gpt-4.1"

# The already-indexed Umicore document
PAGEINDEX_DOC_ID = "pi-cmsu6uapf00cm01nxyx8jyhxx"

# Cited pages match the ORIGINAL 220-page report (we indexed a 200-page copy).
# This is the list of pages trim_pdf.py removed; the app maps indexed pages back
# through it. Regenerate with `python trim_pdf.py --list`. A flat
# PAGEINDEX_PAGE_OFFSET is only correct when all drops precede kept content.
PAGEINDEX_DROPPED_PAGES = "1-2,3,5-6,200-204,211-213,214-218,219-220"
PAGEINDEX_OUTLINE_CHAR_BUDGET = "120000"
PAGEINDEX_CONTEXT_CHAR_BUDGET = "90000"

# Keep this false on any shared deployment: uploading spends PageIndex credits
# and consumes the account's active-page allowance.
PAGEINDEX_ALLOW_UPLOAD = "false"

# Optional shared password, OFF by default.
# This deployment uses Streamlit Cloud's viewer allowlist instead, which is real
# authentication. Only set APP_PASSWORD if you also want a second, lightweight
# gate (e.g. before widening the allowlist) - it is a deterrent, not real auth.
# APP_PASSWORD = "choose-something-long"
