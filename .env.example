# ---------------------------------------------------------------------------
# PageIndex — vectorless / reasoning-based RAG
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- PageIndex (document tree indexing + retrieval) ------------------------
# Get one at https://dash.pageindex.ai  -> API Keys
PAGEINDEX_API_KEY=your-pageindex-api-key-here
PAGEINDEX_BASE_URL=https://api.pageindex.ai

# --- OpenAI (reasoning over the tree + answer generation) ------------------
OPENAI_API_KEY=your-openai-api-key-here

# Model used for TREE SEARCH (reads the table-of-contents style outline and
# decides which node ids can answer the question).
# Recommended: gpt-4.1-mini  (better multi-hop node selection, same price band)
# Cheapest workable: gpt-4o-mini
PAGEINDEX_SEARCH_MODEL=gpt-4.1-mini

# Model used for ANSWER GENERATION over the extracted node text.
# Recommended: gpt-4.1 for financial numbers; gpt-4o-mini if cost matters most.
PAGEINDEX_ANSWER_MODEL=gpt-4.1

# --- Local behaviour -------------------------------------------------------
# Where doc_ids and downloaded trees are cached
PAGEINDEX_CACHE_DIR=cache
# Default PDF used by the CLI scripts
PAGEINDEX_DEFAULT_PDF=Umicore Annual Report 2025.pdf
# Pages removed from the ORIGINAL report by trim_pdf.py (1-based, inclusive).
# The app maps every indexed page back through this list so answers cite the
# page in the published 220-page PDF. A flat offset cannot do this correctly:
# pages 200-204 are dropped mid-document, so content after them shifts by 10
# while content before them shifts by 5. Run `python trim_pdf.py --list` to
# regenerate this value. Leave EMPTY if you index the full, untrimmed PDF.
PAGEINDEX_DROPPED_PAGES=1-2,3,5-6,200-204,211-213,214-218,219-220
# Fallback used only when PAGEINDEX_DROPPED_PAGES is empty. Correct ONLY if
# every dropped page comes before all kept content.
PAGEINDEX_PAGE_OFFSET=0
# Max chars of tree outline shown to the search model. ~120k keeps every node
# summary in view (the Umicore outline is ~79k); lower it for small-context models.
PAGEINDEX_OUTLINE_CHAR_BUDGET=120000
# Max characters of node text fed to the answer model (whole context budget)
PAGEINDEX_CONTEXT_CHAR_BUDGET=90000
